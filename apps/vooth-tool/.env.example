# Base URL for the core-api backend used by the renderer.
# electron-vite exposes renderer env vars prefixed with RENDERER_VITE_.
RENDERER_VITE_API_BASE_URL=http://localhost:3000

# Google OAuth desktop client ID used by the Electron main process loopback+PKCE flow.
# This is NOT a secret (the desktop client secret lives only on the server).
# electron-vite exposes main-process env vars prefixed with MAIN_VITE_.
MAIN_VITE_GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
