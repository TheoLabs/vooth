# MySQL (docker-compose.yml 의 mysql 서비스 기준)
MYSQL_HOST=localhost
MYSQL_USERNAME=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app

# AWS (LocalStack 사용 시 임의 값 가능)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-2

# S3 (LocalStack 의 s3 서비스 기준)
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=vooth

# Kafka (docker-compose.yml 의 kafka 서비스 기준 / 미설정 시 아래 값이 기본값)
KAFKA_CLIENT_ID=core-api
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=core-api
# Debezium 토픽: topic.prefix.DB.테이블
KAFKA_DDD_EVENT_TOPIC=dbserver1.vooth.ddd_events


# GOOGLE (관리자 웹 Google 로그인 ID 토큰 검증용)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Desktop(vooth-maker) OAuth 클라이언트 — loopback+PKCE code 교환용 (secret은 서버에만 보관)
GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=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-2

# JWT (access token 서명 / 미설정 시 기본값 사용 - 운영에선 반드시 설정)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=1h