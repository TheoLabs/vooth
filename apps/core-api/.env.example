# MySQL (docker-compose.yml 의 mysql 서비스 기준)
MYSQL_HOST=localhost
MYSQL_USERNAME=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=app

# AWS (LocalStack 사용 시 임의 값 가능)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-2

# S3 (LocalStack 의 s3 서비스 기준)
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=my-bucket
